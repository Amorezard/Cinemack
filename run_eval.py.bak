#!/usr/bin/env python3
"""
Run the Movie Buff test set and record accuracy + speed in one pass.

Two things get measured:

  RETRIEVAL  - auto-graded. Did the expected movie come back in the top-k?
               Objective, needs no judgment, and is unaffected by the prompt
               template below.

  SPEED      - taken from Ollama's own eval_count/eval_duration counters
               rather than wall clock, so it isn't polluted by retrieval
               time or by however long the database took to answer.

Answer quality is NOT auto-graded. The script writes a markdown report with
a checkbox per question for you to mark by hand. At 20 questions that is
faster than building a grader you would then have to trust.

Retrieval is delegated to retrieve.py, so this measures the pipeline you
actually ship. Change retrieve.py, re-run, and compare_runs.py tells you
which questions moved.

Usage:
    source ~/venvs/movie-rag/bin/activate
    cd ~/movie-buff/rag
    python run_eval.py --label baseline-q8_0

    # after the quantization change:
    python run_eval.py --label q5_K_M
    python compare_runs.py results/baseline-q8_0.json results/q5_K_M.json
"""

import argparse
import json
import os
import re
import sqlite3
import sys
import time
import unicodedata
from datetime import datetime

import ollama
import sqlite_vec

from retrieve import retrieve as _retrieve

# --------------------------------------------------------------------------
# Keep these in sync with chat.py. If your chat.py assembles the context
# block differently, paste your version in here - otherwise the eval is
# measuring a prompt you don't actually ship.
# --------------------------------------------------------------------------
CHAT_MODEL = "movie-buff"
EMBED_MODEL = "mxbai-embed-large"
QUERY_PREFIX = "Represent this sentence for searching relevant passages: "

# Copied verbatim from chat.py's build_prompt(). Note the ordering: the
# question sits BETWEEN the context and the honesty instruction, so that
# instruction is the last thing the model reads. Don't "tidy" this.
CONTEXT_TEMPLATE = """Here is information on movies that might be relevant to the question:

{context}

Question: {question}

Answer using the information above. If none of it actually answers the question, \
say so honestly instead of guessing.

Only state a director, cast member, character name, award, or box-office figure if it \
appears in the information above. If a detail is not there, say you don't have it rather \
than recalling it from memory. Never reason out loud or correct yourself mid-answer - if \
you are unsure, say so in one short sentence and move on."""


# --------------------------------------------------------------------------


def normalize(s):
    if s is None:
        return ""
    s = unicodedata.normalize("NFKD", str(s))
    s = "".join(c for c in s if not unicodedata.combining(c))
    return "".join(c for c in s.casefold() if c.isalnum())


def get(obj, *path, default=None):
    """Read a field whether the ollama client returned dicts or objects."""
    cur = obj
    for key in path:
        if cur is None:
            return default
        if isinstance(cur, dict):
            cur = cur.get(key)
        else:
            cur = getattr(cur, key, None)
    return default if cur is None else cur


def open_db(path):
    conn = sqlite3.connect(path)
    conn.enable_load_extension(True)
    sqlite_vec.load(conn)
    conn.enable_load_extension(False)
    return conn


def retrieve(conn, question, k=3, db_path="movies.db", recent_titles=None):
    """Delegates to retrieve.py so the eval measures the retrieval you actually
    ship. It used to run its own copy of the query, which was fine while
    retrieve.py was a plain vector search - but the moment retrieve.py grew a
    relevance cutoff and metadata filters, a self-contained eval would have
    reported the old behavior forever."""
    t0 = time.perf_counter()
    raw = _retrieve(question, k=k, db_path=db_path, recent_titles=recent_titles)
    elapsed_ms = (time.perf_counter() - t0) * 1000

    hits = []
    for h in raw:
        d = h.get("distance")
        hits.append({
            "id": h.get("id"),
            "title": h.get("title"),
            "release_year": h.get("release_year"),
            "genres": h.get("genres"),
            "director": h.get("director"),
            "top_cast": h.get("top_cast"),
            # retrieve.py calls it "text"; chat.py and ask.py rely on that name.
            "embed_text": h.get("text") or h.get("embed_text"),
            "distance": round(d, 4) if isinstance(d, (int, float)) else None,
        })
    # retrieve.py does the embed and the search together, so they can't be
    # timed apart any more. Report the whole thing under embed_ms.
    return hits, elapsed_ms, 0.0


def ask(question, hits, history, think=True, num_predict=None):
    """One turn. Streams so time-to-first-token is a real measurement."""
    if hits:
        context = "\n\n---\n\n".join(h.get("embed_text") or h.get("title", "") for h in hits)
        stuffed = CONTEXT_TEMPLATE.format(context=context, question=question)
    else:
        # chat.py's build_prompt returns the bare question when retrieval comes
        # back empty - no context wrapper at all. Match that, or the eval would
        # misreport what happens once the relevance cutoff starts dropping hits.
        stuffed = question

    messages = history + [{"role": "user", "content": stuffed}]
    options = {}
    if num_predict:
        options["num_predict"] = num_predict

    t0 = time.perf_counter()
    first_token_at = None
    answer, thinking = [], []
    final = None

    stream = ollama.chat(
        model=CHAT_MODEL,
        messages=messages,
        stream=True,
        think=think,
        options=options or None,
        keep_alive="60m",
    )

    for chunk in stream:
        piece = get(chunk, "message", "content", default="")
        thought = get(chunk, "message", "thinking", default="")
        if (piece or thought) and first_token_at is None:
            first_token_at = time.perf_counter() - t0
        if piece:
            answer.append(piece)
        if thought:
            thinking.append(thought)
        if get(chunk, "done", default=False):
            final = chunk

    wall = time.perf_counter() - t0

    eval_count = get(final, "eval_count", default=0) or 0
    eval_ns = get(final, "eval_duration", default=0) or 0
    load_ns = get(final, "load_duration", default=0) or 0
    prompt_count = get(final, "prompt_eval_count", default=0) or 0

    return {
        "answer": "".join(answer).strip(),
        "thinking": "".join(thinking).strip(),
        "time_to_first_token_s": round(first_token_at, 3) if first_token_at else None,
        "wall_seconds": round(wall, 3),
        "output_tokens": eval_count,
        "prompt_tokens": prompt_count,
        "tokens_per_sec": round(eval_count / (eval_ns / 1e9), 2) if eval_ns else None,
        "model_load_seconds": round(load_ns / 1e9, 3) if load_ns else 0.0,
    }


def grade_retrieval(q, turn_hits):
    """Auto-grade the objective half. Returns (verdict, detail)."""
    titles_by_turn = [[h["title"] for h in hits] for hits in turn_hits]

    if q.get("expect_retrieved_final_turn"):
        expected = q["expect_retrieved_final_turn"]
        got, got_hits = titles_by_turn[-1], turn_hits[-1]
        scope = "final turn"
    elif "expect_retrieved" in q:
        expected = q["expect_retrieved"]
        got, got_hits = titles_by_turn[0], turn_hits[0]
        scope = "turn 1"
    elif "expect_rows_match" in q:
        pred = q["expect_rows_match"]
        lo, hi = pred.get("release_year_between", [0, 9999])
        genre = normalize(pred.get("genres_contains", ""))
        ok, bad = 0, []
        for h in turn_hits[0]:
            try:
                year = int(h["release_year"])
            except (TypeError, ValueError):
                year = -1
            in_year = lo <= year <= hi
            in_genre = genre in normalize(h["genres"] or "")
            if in_year and in_genre:
                ok += 1
            else:
                why = []
                if not in_year:
                    why.append(f"year {h['release_year']}")
                if not in_genre:
                    why.append("wrong genre")
                bad.append(f"{h['title']} ({', '.join(why)})")
        if not turn_hits[0]:
            return "FAIL", "nothing retrieved"
        verdict = "PASS" if ok == len(turn_hits[0]) else ("PARTIAL" if ok else "FAIL")
        return verdict, f"{ok}/{len(turn_hits[0])} match" + (f" - off: {'; '.join(bad)}" if bad else "")
    else:
        return "MANUAL", "no retrieval target - grade the answer"

    if not expected:  # no_match questions
        return "MANUAL", f"should find nothing relevant; got {got} - grade the answer"

    want = {normalize(t) for t in expected}
    title_hits = [h for h in got_hits if normalize(h["title"]) in want]

    if not title_hits:
        return "FAIL", f"expected {expected}, {scope} returned {got}"

    # Several titles in this database are reused across remakes, shorts and
    # sequels (three Whiplash rows, five Dune-ish rows). Where the test set
    # pins a year, the right title from the wrong year is not a pass - it is
    # a distinct finding, usually pointing at the missing year filter.
    want_year = q.get("expect_year")
    if want_year:
        right = [h for h in title_hits if str(h["release_year"]) == str(want_year)]
        if right:
            return "PASS", f"found in {scope}: {right[0]['title']} ({want_year})"
        versions = ", ".join(f"{h['title']} ({h['release_year']})" for h in title_hits)
        return "WRONG_VERSION", (
            f"matched the title but not the year - wanted {expected[0]} ({want_year}), "
            f"{scope} returned {versions}"
        )

    return "PASS", f"found in {scope}: {got}"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--label", required=True, help="name for this run, e.g. baseline-q8_0")
    ap.add_argument("--db", default="movies.db")
    ap.add_argument("--tests", default="test_set.json")
    ap.add_argument("--k", type=int, default=3)
    ap.add_argument("--no-think", action="store_true", help="run with think=False")
    ap.add_argument("--num-predict", type=int, default=None)
    ap.add_argument("--outdir", default="results")
    ap.add_argument("--only", default=None, help="comma-separated ids, e.g. q01,q12")
    ap.add_argument("--resume", action="store_true",
                    help="skip questions already present in the results file")
    args = ap.parse_args()

    with open(args.tests) as f:
        tests = json.load(f)

    questions = tests["questions"]
    if args.only:
        keep = {s.strip() for s in args.only.split(",")}
        questions = [q for q in questions if q["id"] in keep]

    conn = open_db(args.db)
    os.makedirs(args.outdir, exist_ok=True)
    jpath = os.path.join(args.outdir, f"{args.label}.json")
    mpath = os.path.join(args.outdir, f"{args.label}.md")

    # A 25-minute run over a university SSH session will sometimes die partway
    # through. Results are flushed after every question, so a dropped
    # connection costs one question, not the whole run.
    results = []
    if args.resume and os.path.exists(jpath):
        with open(jpath) as f:
            results = json.load(f).get("results", [])
        done = {r["id"] for r in results}
        questions = [q for q in questions if q["id"] not in done]
        print(f"Resuming '{args.label}' - {len(done)} already done, "
              f"{len(questions)} to go\n")

    print(f"Run '{args.label}' - {len(questions)} questions, k={args.k}, "
          f"think={not args.no_think}\n")

    # Pre-warm so the first question doesn't absorb the cold-load cost and
    # skew every timing number that follows.
    print("  pre-warming models...", end=" ", flush=True)
    t0 = time.perf_counter()
    ollama.embed(model=EMBED_MODEL, input=["warmup"], keep_alive="60m")
    ollama.chat(model=CHAT_MODEL, messages=[{"role": "user", "content": "hi"}],
                options={"num_predict": 1}, keep_alive="60m")
    print(f"{time.perf_counter() - t0:.1f}s\n")

    for q in questions:
        print(f"  {q['id']} [{q['category']}] {q['turns'][0][:58]}...")
        history, turn_hits, turns_out = [], [], []
        recent_titles = []

        for turn_text in q["turns"]:
            hits, embed_ms, search_ms = retrieve(conn, turn_text, k=args.k,
                                                db_path=args.db,
                                                recent_titles=recent_titles)
            if hits:
                recent_titles = [h["title"] for h in hits]
            turn_hits.append(hits)
            out = ask(turn_text, hits, history,
                      think=not args.no_think, num_predict=args.num_predict)
            out["question"] = turn_text
            out["embed_ms"] = round(embed_ms, 1)
            out["search_ms"] = round(search_ms, 1)
            out["retrieved"] = [
                {"title": h["title"], "year": h["release_year"],
                 "distance": h["distance"], "has_credits": bool(h["director"] or h["top_cast"])}
                for h in hits
            ]
            turns_out.append(out)

            # Same as chat.py: store the plain question, not the stuffed prompt,
            # so history doesn't balloon with repeated movie blurbs.
            history.append({"role": "user", "content": turn_text})
            history.append({"role": "assistant", "content": out["answer"]})

        verdict, detail = grade_retrieval(q, turn_hits)

        # A cheap substring check where the test set named expected strings.
        contains = None
        if q.get("expect_answer_contains"):
            final_answer = turns_out[-1]["answer"].lower()
            found = [s for s in q["expect_answer_contains"] if s.lower() in final_answer]
            contains = {"wanted_any_of": q["expect_answer_contains"], "found": found}

        results.append({
            "id": q["id"],
            "category": q["category"],
            "maps_to": q.get("maps_to"),
            "expect_behavior": q.get("expect_behavior"),
            "retrieval_verdict": verdict,
            "retrieval_detail": detail,
            "answer_contains": contains,
            "turns": turns_out,
        })

        # Flush after every question so a dropped SSH session costs one
        # question instead of the whole run.
        with open(jpath, "w") as f:
            json.dump(build_payload(results, args), f, indent=2)

        tps = turns_out[-1]["tokens_per_sec"]
        print(f"       retrieval: {verdict:<8} {tps or '?'} tok/s   "
              f"ttft {turns_out[-1]['time_to_first_token_s']}s")

    payload = build_payload(results, args)
    with open(jpath, "w") as f:
        json.dump(payload, f, indent=2)
    write_report(mpath, payload)
    summary = payload["summary"]
    graded = [r for r in results if r["retrieval_verdict"] in ("PASS", "FAIL", "PARTIAL", "WRONG_VERSION")]
    passed = [r for r in graded if r["retrieval_verdict"] == "PASS"]

    print(f"\n{'=' * 62}")
    print(f"  Retrieval (auto):  {len(passed)}/{len(graded)} passed")
    print(f"  Median speed:      {summary['median_tokens_per_sec']} tok/s")
    print(f"  Time to first tok: {summary['median_time_to_first_token_s']}s")
    print(f"  Median full wait:  {summary['median_wall_seconds']}s  "
          f"(what chat.py makes you wait today)")
    print(f"  Output length:     {summary['median_output_tokens']} tokens median, "
          f"{summary['max_output_tokens']} max")
    print(f"{'=' * 62}")
    print(f"\n  {jpath}\n  {mpath}   <- grade the behavior questions in here")
    conn.close()
    return 0


def build_payload(results, args):
    """Summary + results. Called after every question so the file on disk is
    always a valid, complete-as-of-now run rather than a half-written one."""
    graded = [r for r in results
              if r["retrieval_verdict"] in ("PASS", "FAIL", "PARTIAL", "WRONG_VERSION")]
    passed = [r for r in graded if r["retrieval_verdict"] == "PASS"]
    all_turns = [t for r in results for t in r["turns"]]
    tps_vals = [t["tokens_per_sec"] for t in all_turns if t["tokens_per_sec"]]
    ttft_vals = [t["time_to_first_token_s"] for t in all_turns if t["time_to_first_token_s"]]
    wall_vals = [t["wall_seconds"] for t in all_turns]
    out_toks = [t["output_tokens"] for t in all_turns if t["output_tokens"]]

    def med(xs):
        if not xs:
            return None
        s = sorted(xs)
        return round(s[len(s) // 2], 2)

    summary = {
        "label": args.label,
        "when": datetime.now().isoformat(timespec="seconds"),
        "k": args.k,
        "think": not args.no_think,
        "questions": len(results),
        "retrieval_auto_graded": len(graded),
        "retrieval_passed": len(passed),
        "median_tokens_per_sec": med(tps_vals),
        "median_time_to_first_token_s": med(ttft_vals),
        "median_wall_seconds": med(wall_vals),
        "median_output_tokens": med(out_toks),
        "max_output_tokens": max(out_toks) if out_toks else None,
        "by_category": {},
    }
    for r in graded:
        c = summary["by_category"].setdefault(r["category"], {"pass": 0, "total": 0})
        c["total"] += 1
        if r["retrieval_verdict"] == "PASS":
            c["pass"] += 1

    return {"summary": summary, "results": results}


def write_report(path, payload):
    s, results = payload["summary"], payload["results"]
    L = []
    L.append(f"# Movie Buff eval - `{s['label']}`\n")
    L.append(f"{s['when']} | k={s['k']} | think={s['think']}\n")
    L.append("## Numbers\n")
    L.append("| Measure | Value |")
    L.append("| --- | --- |")
    L.append(f"| Retrieval passed (auto) | {s['retrieval_passed']}/{s['retrieval_auto_graded']} |")
    L.append(f"| Median tokens/sec | {s['median_tokens_per_sec']} |")
    L.append(f"| Median time to first token | {s['median_time_to_first_token_s']}s |")
    L.append(f"| Median full response wait | {s['median_wall_seconds']}s |")
    L.append(f"| Median output length | {s['median_output_tokens']} tokens |")
    L.append(f"| Longest output | {s['max_output_tokens']} tokens |")
    L.append("")
    L.append("| Category | Retrieval pass rate |")
    L.append("| --- | --- |")
    for cat, c in sorted(s["by_category"].items()):
        L.append(f"| {cat} | {c['pass']}/{c['total']} |")
    L.append("")
    L.append("## Grade these by hand\n")
    L.append("Mark `[x]` for pass. The retrieval verdict is already decided; "
             "what you're judging is whether the *answer* did the right thing.\n")

    for r in results:
        L.append(f"### {r['id']} - {r['category']}  ({r['retrieval_verdict']})\n")
        L.append(f"**Should do:** {r['expect_behavior']}\n")
        L.append(f"*Retrieval: {r['retrieval_detail']}*\n")
        if r["answer_contains"]:
            ac = r["answer_contains"]
            hit = ", ".join(ac["found"]) if ac["found"] else "none"
            L.append(f"*Looked for {ac['wanted_any_of']} in the answer - found: {hit}*\n")
        for i, t in enumerate(r["turns"], 1):
            if len(r["turns"]) > 1:
                L.append(f"**Turn {i}:** {t['question']}\n")
            got = ", ".join(
                f"{h['title']} ({h['year']}, d={h['distance'] if h['distance'] is not None else 'pop'}"
                + (", credits" if h["has_credits"] else "") + ")"
                for h in t["retrieved"]
            )
            L.append(f"Retrieved: {got or '(nothing)'}\n")
            L.append(f"> {t['answer'].replace(chr(10), chr(10) + '> ')}\n")
            L.append(f"`{t['tokens_per_sec']} tok/s | ttft {t['time_to_first_token_s']}s "
                     f"| {t['output_tokens']} tokens | {t['wall_seconds']}s total`\n")
        L.append("- [ ] answer is correct\n")
        L.append("---\n")

    with open(path, "w") as f:
        f.write("\n".join(L))


if __name__ == "__main__":
    sys.exit(main())
