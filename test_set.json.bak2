{
  "version": 1,
  "created": "2026-09-21 (rev 2: year disambiguation after check_coverage)",
  "about": "Movie Buff evaluation set. 20 questions chosen so that each one maps to a specific fix on the roadmap - when you re-run this after a change, the per-category breakdown tells you which fix actually moved, instead of a single number that went up or down for unknown reasons.",
  "grading": {
    "retrieval": "Auto-graded. Did the expected movie come back in the top-k? Objective, no judgment needed.",
    "behavior": "Manually graded. The runner writes a report with a checkbox per question; you mark it. There is no LLM judge here on purpose - at 20 questions, reading them is faster and more trustworthy than building a grader you would then have to trust.",
    "year_disambiguation": "Where expect_year is set, a title match with the wrong year grades as WRONG_VERSION, not PASS. Several titles in this database are reused across remakes, shorts and sequels, and scoring those as passes would quietly inflate every run."
  },
  "categories": {
    "exact_title": "Someone types a real title. Pure vector search often returns something thematically similar instead. Maps to: hybrid title matching.",
    "semantic": "Descriptive question with no title in it. This is what vector search is genuinely good at - these should already pass, and are here as a regression guard.",
    "metadata": "Question carries a structured filter (year, genre, director). Maps to: metadata pre-filtering.",
    "credits_present": "Cast/director exists for this movie (it overlaps the TMDB 5000 credits file). Should answer correctly.",
    "credits_missing": "Cast/director does NOT exist in your DB. Must say so rather than invent a plausible name. Maps to: prompt tightening.",
    "no_match": "Nothing relevant exists. Must decline rather than build an answer from whatever came back closest. Maps to: relevance cutoff.",
    "followup": "Multi-turn, second question uses a pronoun. Currently expected to fail. Maps to: follow-up query rewriting.",
    "persona": "LoRA behavior - spoiler etiquette in both directions, and recommendation quality."
  },
  "questions": [
    {
      "id": "q01",
      "category": "exact_title",
      "maps_to": "hybrid_title_search",
      "turns": [
        "Tell me about The Departed."
      ],
      "expect_retrieved": [
        "The Departed"
      ],
      "expect_behavior": "Describes the actual film - Boston, undercover cop, mob informant. Not a thematically similar crime film.",
      "expect_year": "2006"
    },
    {
      "id": "q02",
      "category": "exact_title",
      "maps_to": "hybrid_title_search",
      "turns": [
        "What's Whiplash about?"
      ],
      "expect_retrieved": [
        "Whiplash"
      ],
      "expect_behavior": "Your DB has three Whiplash rows: the 2014 feature, the 2013 SHORT FILM Chazelle made first, and Whiplash 2 (2025). Only 2014 counts. Returning the short is a real failure - the plots are nearly identical, so vector search has every reason to confuse them. Jazz drummer and an abusive instructor. Short title, common English word - a likely failure case for pure vector search.",
      "expect_year": "2014"
    },
    {
      "id": "q03",
      "category": "exact_title",
      "maps_to": "hybrid_title_search",
      "turns": [
        "Tell me about Eternal Sunshine of the Spotless Mind."
      ],
      "expect_retrieved": [
        "Eternal Sunshine of the Spotless Mind"
      ],
      "expect_behavior": "Long distinctive title - should be the easy end of exact matching. If this one fails, title matching is badly broken.",
      "expect_year": "2004"
    },
    {
      "id": "q04",
      "category": "exact_title",
      "maps_to": "hybrid_title_search",
      "turns": [
        "What's Schindlers List about?"
      ],
      "expect_retrieved": [
        "Schindler's List"
      ],
      "expect_behavior": "Note the missing apostrophe - this is the fuzzy-match case. A plain SQL equality check will miss it; LIKE or normalization will catch it.",
      "expect_year": "1993"
    },
    {
      "id": "q05",
      "category": "semantic",
      "maps_to": "baseline_vector_search",
      "turns": [
        "What's that Scorsese movie about an undercover cop in the Boston mob?"
      ],
      "expect_retrieved": [
        "The Departed"
      ],
      "expect_behavior": "Should already pass. Same target as q01 by a completely different route - if q05 passes and q01 fails, that is the exact-title gap proven in one pair.",
      "expect_year": "2006"
    },
    {
      "id": "q06",
      "category": "semantic",
      "maps_to": "baseline_vector_search",
      "turns": [
        "There's a film where the main character can't form new memories and covers himself in tattoos to keep track of things. What is it?"
      ],
      "expect_retrieved": [
        "Memento"
      ],
      "expect_behavior": "Should already pass.",
      "expect_year": "2000"
    },
    {
      "id": "q07",
      "category": "semantic_hard",
      "maps_to": "known_limit",
      "turns": [
        "A movie about a poor family who each get hired by a wealthy household while hiding that they're related?"
      ],
      "expect_retrieved": [
        "Parasite"
      ],
      "expect_behavior": "Known limit, kept on purpose. TMDB's Parasite plot never says 'hired' or 'hiding that they're related', and movie-buff does not recognise the film from a description (guesses The Parent Trap). Layout change, bge-m3 and title guessing were all tested and none retrieve it. Expected to FAIL until the data or model changes.",
      "expect_year": "2019"
    },
    {
      "id": "q08",
      "category": "metadata",
      "maps_to": "metadata_prefilter",
      "turns": [
        "Recommend me some science fiction movies from the 1980s."
      ],
      "expect_rows_match": {
        "release_year_between": [
          1980,
          1989
        ],
        "genres_contains": "Science Fiction"
      },
      "expect_behavior": "Every film named should actually be 1980s sci-fi. The common failure is recommending correct-genre films from the wrong decade."
    },
    {
      "id": "q09",
      "category": "metadata",
      "maps_to": "metadata_prefilter",
      "turns": [
        "What's a good horror movie that came out after 2015?"
      ],
      "expect_rows_match": {
        "release_year_between": [
          2016,
          2026
        ],
        "genres_contains": "Horror"
      },
      "expect_behavior": "Year filter is the thing under test. Recommending The Shining here is a clean failure."
    },
    {
      "id": "q10",
      "category": "credits_present",
      "maps_to": "credits_coverage",
      "turns": [
        "Who directed Pulp Fiction?"
      ],
      "expect_retrieved": [
        "Pulp Fiction"
      ],
      "expect_answer_contains": [
        "Tarantino"
      ],
      "expect_behavior": "Pre-2017 and popular, so it should be inside the TMDB 5000 overlap and have real director data. Run check_coverage.py to confirm before trusting this one.",
      "expect_year": "1994"
    },
    {
      "id": "q11",
      "category": "credits_present",
      "maps_to": "credits_coverage",
      "turns": [
        "Who starred in Fight Club?"
      ],
      "expect_retrieved": [
        "Fight Club"
      ],
      "expect_answer_contains": [
        "Pitt",
        "Norton"
      ],
      "expect_behavior": "Should name actual cast from the retrieved text. Either surname counts as a pass.",
      "expect_year": "1999"
    },
    {
      "id": "q12",
      "category": "credits_present",
      "maps_to": "credits_rebuild",
      "turns": [
        "Who directed Everything Everywhere All at Once?"
      ],
      "expect_retrieved": [
        "Everything Everywhere All at Once"
      ],
      "expect_behavior": "Credits now exist. PASS = names Daniel Kwan and Daniel Scheinert. FAIL = says it has no director info, or names anyone else.",
      "expect_year": "2022"
    },
    {
      "id": "q13",
      "category": "credits_present",
      "maps_to": "credits_rebuild",
      "turns": [
        "Who starred in the 2021 version of Dune?"
      ],
      "expect_retrieved": [
        "Dune"
      ],
      "expect_behavior": "Credits now exist. PASS = names cast from the context, including Timothee Chalamet. FAIL = says it has no cast info, or names someone not in the context.",
      "expect_year": "2021"
    },
    {
      "id": "q14",
      "category": "no_match",
      "maps_to": "relevance_cutoff",
      "turns": [
        "What can you tell me about the 1987 film The Cobalt Hour, directed by Elias Marchetti?"
      ],
      "expect_retrieved": [],
      "expect_behavior": "This film does not exist - invented for this test. Retrieval returns nothing (year filter + distance cutoff), so the model gets the bare question. PASS = says it has nothing on it. FAIL = any plot, cast or director."
    },
    {
      "id": "q15",
      "category": "no_match",
      "maps_to": "relevance_cutoff",
      "turns": [
        "What's a good recipe for carbonara?"
      ],
      "expect_retrieved": [],
      "expect_behavior": "Off-topic on purpose. PASS = says it's a movie assistant / has nothing relevant. FAIL = answers from the three unrelated movies retrieval handed it, or silently drops the RAG context and answers as a general chatbot."
    },
    {
      "id": "q16",
      "category": "followup",
      "maps_to": "followup_rewriting",
      "turns": [
        "Tell me about The Departed.",
        "Who directed it?"
      ],
      "expect_retrieved_final_turn": [
        "The Departed"
      ],
      "expect_answer_contains": [
        "Scorsese"
      ],
      "expect_behavior": "Expected to FAIL at baseline. Turn 2 is embedded as the bare string 'Who directed it?', which retrieves nothing useful. Grade the retrieval on turn 2 specifically - the model may still answer correctly from conversation history, which masks a retrieval failure. That distinction is the whole point of this question.",
      "expect_year": "2006"
    },
    {
      "id": "q17",
      "category": "followup",
      "maps_to": "followup_rewriting",
      "turns": [
        "What's a good Denis Villeneuve science fiction film?",
        "What year did that one come out?"
      ],
      "expect_behavior": "Expected to FAIL at baseline, same mechanism as q16. Pass condition: the year is correct AND turn 2 retrieved the film being discussed."
    },
    {
      "id": "q18",
      "category": "persona",
      "maps_to": "lora_behavior",
      "turns": [
        "Is Fight Club worth watching?"
      ],
      "expect_behavior": "PASS = recommends it without revealing the twist. FAIL = spoils it unprompted. Tests spoiler etiquette in the holding-back direction."
    },
    {
      "id": "q19",
      "category": "persona",
      "maps_to": "lora_behavior",
      "turns": [
        "I don't mind spoilers at all - what's the twist in The Sixth Sense?"
      ],
      "expect_behavior": "PASS = actually tells them. Tests the other direction: an over-cautious model that refuses here has learned the spoiler rule too rigidly. Included because q18 alone can be passed by a model that just never says anything."
    },
    {
      "id": "q20",
      "category": "persona",
      "maps_to": "lora_behavior",
      "turns": [
        "I just watched Parasite and really loved it. What should I watch next?"
      ],
      "expect_behavior": "PASS = warm tone, 3-4 defensible recommendations, and a follow-up question about taste. This is the closest question to the 16 training examples, so it's the canary for whether the LoRA survived re-quantization in step 3."
    },
    {
      "id": "q21",
      "category": "credits_missing",
      "maps_to": "prompt_tightening",
      "turns": [
        "Who directed Mulholland Dr.?"
      ],
      "expect_retrieved": [
        "Mulholland Dr."
      ],
      "expect_year": "1999",
      "expect_behavior": "Real, famous film with NO credits in the database. PASS = says it doesn't have director info. FAIL = names David Lynch or anyone else - that is pretraining leaking past the context rule."
    },
    {
      "id": "q22",
      "category": "title_trap",
      "maps_to": "title_guard",
      "turns": [
        "the one where Matt Damon plays a mole in the Boston police"
      ],
      "expect_retrieved": [
        "The Departed"
      ],
      "expect_year": "2006",
      "expect_behavior": "Phrase that contains film titles ('The One', 'Police'). PASS = The Departed retrieved and answered; no film called The One or Police in the context."
    },
    {
      "id": "q23",
      "category": "exact_title",
      "maps_to": "title_promotion",
      "turns": [
        "tell me about whiplash"
      ],
      "expect_retrieved": [
        "Whiplash"
      ],
      "expect_year": "2014",
      "expect_behavior": "Lowercase title. PASS = answers about Whiplash (2014), the Damien Chazelle film, not Whiplash 2."
    }
  ]
